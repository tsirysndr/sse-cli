  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tsirysndr/sse-cli.git"
  },
  "module": "index.ts",
  "type": "module",
  "private": false,
  "files": [
    "dist/sse.js"
  ],
  "scripts": {
